# Copy to .env and fill in. .env is gitignored — never commit real secrets.
# (Variables per build-playbook §1.2, plus the shared HTTP client knobs.)

# --- SEC EDGAR (mandatory for any sec.gov request) ---------------------------
# Missing User-Agent = 403 from sec.gov. Use a real, descriptive contact string.
SEC_USER_AGENT="YourCo contact@you.com"

# --- Supabase (worker WRITES + api READS, both with the service-role key) -----
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- 8-K classification (Phase 4) — HOSTED model only ------------------------
ANTHROPIC_API_KEY=

# --- Optional: domain resolver for name -> website (Phase 2) -----------------
DOMAIN_RESOLVER_API_KEY=

# --- RapidAPI proxy secret (Phase 5) — validates traffic came via RapidAPI ---
RAPIDAPI_PROXY_SECRET=

# --- Shared HTTP client (HARD RULE: <= 10 req/s across ALL sec.gov domains) ---
HTTP_MAX_REQUESTS_PER_SECOND=10
HTTP_TIMEOUT_SECONDS=30
