# Copy to .env and fill in. .env is gitignored — never commit real secrets.
# (Variables per build-playbook §1.2, plus the shared HTTP client knobs.)

# --- SEC EDGAR (mandatory for any sec.gov request) ---------------------------
# Missing User-Agent = 403 from sec.gov. Use a real, descriptive contact string.
SEC_USER_AGENT="YourCo contact@you.com"

# --- Supabase (worker WRITES + api READS, both with the service-role key) -----
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- 8-K classification (Phase 4) — choose a provider -----------------------
# 'anthropic' = hosted (highest quality, costs per call); 'ollama' = LOCAL model
# via Ollama (FREE, no API key, no per-call cost — needs Ollama running).
EIGHT_K_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Cheaper + faster hosted model (≈10x less than Sonnet); good enough here:
ANTHROPIC_MODEL=claude-sonnet-4-6
# Free local alternative (EIGHT_K_PROVIDER=ollama). `ollama pull llama3.1` first.
OLLAMA_MODEL=llama3.1
OLLAMA_CHAT_URL=http://localhost:11434/api/chat
# Cost control: skip high-volume low-value 8-K items (8.01 Other, 1.01/1.02).
EIGHT_K_SKIP_LOW_VALUE=false

# --- Optional: domain resolver for name -> website (Phase 2) -----------------
# Set BOTH to engage the higher-recall API backend; otherwise seeding uses the
# DNS heuristic. The endpoint is queried with ?name=<legal name>&country=<state>.
DOMAIN_RESOLVER_API_KEY=
DOMAIN_RESOLVER_API_URL=

# --- Demo mode: serve seeded SAMPLE data so /demo renders without a database ---
# Set to 1/true to run the read API on fictional sample rows (no Supabase, no
# supabase package needed). Leave empty/false in production.
SIGNALS_DEMO_DATA=

# --- RapidAPI proxy secret (Phase 5) — validates traffic came via RapidAPI ---
RAPIDAPI_PROXY_SECRET=
RAPIDAPI_PROXY_HEADER=X-RapidAPI-Proxy-Secret

# --- Shared HTTP client (HARD RULE: <= 10 req/s across ALL sec.gov domains) ---
HTTP_MAX_REQUESTS_PER_SECOND=10
HTTP_TIMEOUT_SECONDS=30
# Transient-failure retries (429/5xx + network errors), exponential backoff.
# Each retry re-acquires a rate slot, so it never breaches the req/s cap. 0 = off.
HTTP_MAX_RETRIES=3
HTTP_RETRY_BACKOFF_SECONDS=0.5
